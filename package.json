{
  "name": "pbs-to-slurm-converter",
  "version": "1.3.0",
  "description": "Dependency-free browser utility for bidirectional PBS/OpenPBS/PBS Pro/TORQUE and Slurm batch-script conversion",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:ui": "python3 tests/ui/browser_smoke.py",
    "check": "find public/assets/js tests -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {},
  "keywords": [
    "pbs",
    "openpbs",
    "pbs-pro",
    "torque",
    "slurm",
    "converter",
    "hpc",
    "job-submission"
  ]
}
